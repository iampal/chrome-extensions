{
  "manifest_version": 3,
  "name": "LinkedIn Outreach Copilot - AI Icebreakers & Lead Exporter",
  "version": "2.1.0",
  "description": "Generate hyper-personalized cold outreach sequences, verify corporate emails via DNS/MX, and 1-click export leads from LinkedIn.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://linkedin.com/*",
    "https://dns.google/*",
    "https://cloudflare-dns.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Outreach Copilot"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
